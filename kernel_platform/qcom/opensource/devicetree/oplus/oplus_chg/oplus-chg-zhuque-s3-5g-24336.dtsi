&soc {
	oplus_cpa: oplus,cpa {
		compatible = "oplus,cpa";
		oplus,protocol_list = <CHG_PROTOCOL_VOOC 45
					   CHG_PROTOCOL_PPS 33
					   CHG_PROTOCOL_PD 18
				       CHG_PROTOCOL_QC 18>;
		oplus,default_protocol_list = <CHG_PROTOCOL_VOOC
					       CHG_PROTOCOL_PPS
					       CHG_PROTOCOL_PD>;
	};
};

&usb2_phy0 {
	qcom,param-override-seq =
		<0x87 0x6c
		0x0d 0x70
		0x04 0x74
		0x70 0x78>;

	qcom,param-override-seq-host =
		<0x87 0x6c
		0x05 0x70
		0x04 0x74
		0x70 0x78>;
};
