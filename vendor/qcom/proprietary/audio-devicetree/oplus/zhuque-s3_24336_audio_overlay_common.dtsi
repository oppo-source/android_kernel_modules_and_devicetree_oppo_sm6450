&waipio_snd {
	oplus,mbhc-check-cross-conn = <1>;
	oplus,mbhc-headset-detect-mode = <0>;
	qcom,msm-mbhc-usbc-audio-supported = <0>;

	// enable HS_G usbc detect
	hs-g-usbc-det-support = <1>;

	// add for HS-G to CC test
	pinctrl-names = "default";
	pinctrl-0 = <&usbc_insert>;
	hs-g-gpio = <&tlmm 43 0>;
};

&tlmm {
	usbc_insert: usbc_insert {
		mux {
			pins = "gpio43";
			function = "gpio";
		};

		config {
			pins = "gpio43";
			drive-strength = <2>;
			bias-pull-down;
			qcom,apps;
		};
	};
};

&qupv3_se2_i2c {
	status = "ok";
	qcom,clk-freq-out = <400000>;

	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		reset-gpio = <&tlmm 96 0>;
		dev_index = < 1 >;
		aw-rx-topo-id = <0x1000ff00>;
		aw-rx-port-id = <0xB030>;
		status = "okay";
	};

	aw87xxx_pa@5b {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x5b>;
		reset-gpio = <&tlmm 58 0>;
		dev_index = < 0 >;
		aw-rx-topo-id = <0x1000ff00>;
		aw-rx-port-id = <0xB030>;
		status = "okay";
	};
};

