				05 00 00 60 00 00 01 38
				39 00 00 20 00 00 03 51 00 00
				];

				qcom,mdss-dsi-aod-high-mode-command = [
				15 00 00 60 00 00 02 6F 04
				39 00 00 20 00 00 03 51 07 FF
				];

				qcom,mdss-dsi-aod-low-mode-command = [
				15 00 00 60 00 00 02 6F 04
				39 00 00 20 00 00 03 51 03 FF
				];

				qcom,mdss-dsi-lhbm-pressed-icon-on-command = [
					39 00 00 20 00 00 1C A9 01 00 87 00 00 25 02 00 DF 31 32 00 1A 02 00 DF 38 39 09 7C 01 00 51 09 0A 8F FE
				];

				qcom,mdss-dsi-lhbm-pressed-icon-off-command = [
					39 00 00 20 00 00 0E A9 01 00 87 00 00 20 01 00 51 09 0A 00 00
				];

				qcom,mdss-dsi-lhbm-icon-on-gama-update0-command = [
