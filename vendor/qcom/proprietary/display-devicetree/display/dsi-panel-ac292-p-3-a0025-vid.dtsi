				];
				qcom,mdss-dsi-lhbm-icon-off-gama-update0-command = [
					39 00 00 60 00 00 06 F0 55 AA 52 08 08
					15 00 00 60 00 00 02 6F 55
					39 00 00 60 00 00 19 B8 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0 17 A0
					39 00 00 60 00 00 14 A9 01 00 87 00 00 20 01 00 51 09 0A 00 00 02 00 B2 1E 1E 80
					39 00 00 20 00 00 15 A9 02 04 B5 01 03 00 00 03 02 00 C0 09 09 00 01 00 9D 00 00 AA

				];
				qcom,mdss-dsi-lhbm-icon-off-gama-update1-command = [
					39 00 00 20 00 00 14 A9 01 00 87 00 00 20 01 00 51 09 0A 00 00 02 00 B2 1E 1E 80
				];


				qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-off-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-vid-120hz-switch-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-vid-90hz-switch-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-vid-60hz-switch-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-lp1-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-nolp-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-aod-high-mode-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-aod-low-mode-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-lhbm-pressed-icon-on-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-lhbm-pressed-icon-off-command-state = "dsi_hs_mode";

				qcom,compression-mode = "dsc";
