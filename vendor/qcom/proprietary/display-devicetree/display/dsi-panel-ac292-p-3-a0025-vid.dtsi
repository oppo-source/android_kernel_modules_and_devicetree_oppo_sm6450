				39 00 00 40 00 00 06 F0 55 AA 52 08 08
				15 00 00 40 00 00 02 6F 44
				39 00 00 40 00 00 15 B0 00 00 39 55 34 A4 2A E3 24 92 38 21 3F F0 3F F0 3F F0 3F F0

				15 00 00 40 78 00 02 11 00
				15 00 00 00 00 00 02 29 00
				];

				qcom,mdss-dsi-off-command = [
				/* Display Off(28h) */
				15 01 00 00 14 00 02 28 00
				/* Sleep In(10h) */
				15 01 00 00 96 00 02 10 00
				];

				qcom,mdss-dsi-demura-dbv-mode-0-command = [
					/* 0x1147 > DBV >= 0x001 */
				39 00 00 40 00 00 03 51 04 7B
				39 00 00 00 00 00 15 A9 02 04 B5 01 03 00 00 03 02 00 C0 09 09 00 01 00 9D 00 00 AA
				];
				qcom,mdss-dsi-demura-dbv-mode-1-command = [
					/* 0xFFE > DBV >= 0x1148 */
				39 00 00 40 00 00 03 51 04 7C
				39 00 00 00 00 00 15 A9 02 04 B5 01 03 00 00 0C 02 00 C0 09 09 55 01 00 9D 00 00 AA
				];

				qcom,mdss-dsi-vid-120hz-switch-command = [
				15 00 00 60 00 00 02 2F 01
				39 00 00 20 00 00 0D A9 01 00 2F 00 00 01 02 00 DF 31 31 00
				];

				qcom,mdss-dsi-vid-90hz-switch-command = [
				15 00 00 50 00 00 02 2F 02
				39 00 00 10 00 00 0D A9 01 00 2F 00 00 02 02 00 DF 31 31 01
				];

