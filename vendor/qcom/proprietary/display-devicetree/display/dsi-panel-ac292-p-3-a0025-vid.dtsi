				qcom,mdss-dsi-panel-width = <1080>;
				qcom,mdss-dsi-panel-height = <2372>;
				qcom,mdss-dsi-h-front-porch = <176>;
				qcom,mdss-dsi-h-back-porch = <32>;
				qcom,mdss-dsi-h-pulse-width = <16>;
