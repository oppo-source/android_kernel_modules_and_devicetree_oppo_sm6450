					39 00 00 20 00 00 15 A9 02 04 B5 01 03 00 00 0C 02 00 C0 09 09 55 01 00 9D 00 00 AA
				];
				qcom,mdss-dsi-lhbm-icon-on-gama-update1-command = [
					39 00 00 20 00 00 20 A9 01 00 87 00 00 05 02 00 B2 1E 1E 00 02 00 DF 00 00 01 02 00 DF 32 32 06 01 00 51 09 0A 00 00
				];
				qcom,mdss-dsi-lhbm-icon-on-gama-update2-command = [
					39 00 00 20 00 00 20 A9 01 00 87 00 00 05 02 00 B2 1E 1E 00 02 00 DF 00 00 01 02 00 DF 32 32 06 01 00 51 09 0A 00 00
				];
				qcom,mdss-dsi-lhbm-icon-on-gama-update3-command = [
					39 00 00 20 00 00 20 A9 01 00 87 00 00 05 02 00 B2 1E 1E 00 02 00 DF 00 00 01 02 00 DF 32 32 06 01 00 51 09 0A 00 00
				];
				qcom,mdss-dsi-lhbm-icon-on-gama-update4-command = [
